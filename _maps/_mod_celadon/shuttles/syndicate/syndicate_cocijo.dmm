	pixel_x = 8;
	name = "medal of exceptional killing spree";
	desc = "An extremely rare golden medal awarded only by Syndicate. To receive such a medal is the highest honor and as such, very few exist. This medal is almost never awarded to anybody but commanders. The writing on it says: 'I am not your enemy. I am THE enemy.'"
